# ============================================================
# Bangla Fashions — docker-compose environment template
# ============================================================
# Copy this file to .env on the deployment host (next to docker-compose.yml):
#     cp .env.docker.example .env
# Then fill in real values. NEVER commit the .env file.
# ============================================================

# --- MongoDB (self-hosted via Docker) ---
# Root admin credentials (created on first boot).
MONGO_ROOT_USER=mongoadmin
MONGO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_STRING

# Application DB user/credentials/database name.
# NOTE: With the current single-image setup, the backend connects as the root user.
# These are kept for future when we add an init script to create a least-privilege user.
MONGO_APP_USER=mongoadmin
MONGO_APP_PASSWORD=REPLACE_WITH_LONG_RANDOM_STRING
MONGO_APP_DB=bangla_fashions

# --- App URLs ---
# Both values are the live domain: Caddy terminates TLS and serves the storefront
# and the API from the same origin, so there is no separate api. hostname.
# Public URL the browser sees. Used for SEO, canonical/openGraph URLs and CORS.
FRONTEND_URL=https://banglafashions.com
# Backend URL the browser uses to reach the API. Behind Caddy this is the same as
# FRONTEND_URL. Also passed to the backend as PUBLIC_API_URL so the SSLCommerz
# success/fail/cancel/IPN callbacks are absolute URLs the gateway can reach.
PUBLIC_BACKEND_URL=https://banglafashions.com

# Public site URL baked into the frontend image at build time.
# CHANGING THE DOMAIN LATER IS NOT JUST AN .env EDIT: NEXT_PUBLIC_* values are
# inlined into the JS bundle by `next build`, so a new domain needs a frontend
# IMAGE REBUILD (docker compose build frontend && docker compose up -d), not a
# restart. Keep this in sync with the build arg in docker-compose.yml.
NEXT_PUBLIC_SITE_URL=https://banglafashions.com

# --- Auth ---
# Long random string. Generate with:   openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Comma-separated emails allowed to log in as admin (lowercase, no spaces).
# This gates admin login — an account is only an admin if its email is listed here.
ADMIN_EMAILS=banglafashion2007@gmail.com

# --- License ---
# REQUIRED IN PRODUCTION. The backend runs with NODE_ENV=production in Docker and
# will refuse to boot without this — it exits immediately with an "Invalid
# environment configuration" error (backend/src/config/env.js). A container that
# restarts in a loop right after `docker compose up` is almost always this.
# The token is issued PER DOMAIN by the seller and only validates on the domain it
# was signed for. See docs/LICENSING.md.
LICENSE_KEY=

# --- Image storage (VPS disk) ---
# Product images are stored on this server, not on a CDN. Inside the container
# this path is the `uploads-data` named docker volume declared in
# docker-compose.yml, so images survive rebuilds; the database only ever stores
# relative URLs like /uploads/2026/09/<uuid>.webp. mongo-backup tars this volume
# nightly next to the mongodump. Do not point this at a plain container path —
# without the named volume every `docker compose up --build` wipes all images.
UPLOAD_DIR=/app/uploads

# --- Email (Brevo / Sendinblue transactional API) ---
# NOT CONFIGURED YET. The owner has not supplied a Brevo API key, so order
# confirmation emails are OFF: with BREVO_API_KEY empty the mailer stays disabled
# and the rest of the site (checkout included) works normally. Leave these as-is
# until a key exists; fill both the key and the From address to switch email on.
BREVO_API_KEY=
MAIL_FROM_NAME=Bangla Fashions
# PLACEHOLDER — must be changed before order emails will send. Brevo only accepts
# a From address on a domain you own and have verified in their dashboard (SPF +
# DKIM records). A gmail.com address will NOT work here and Brevo will reject the
# send. Verify banglafashions.com in Brevo, add the SPF and DKIM records it gives
# you, then set this to noreply@banglafashions.com. The shop's own inbox,
# banglafashion2007@gmail.com, is for customers to write to, not for sending from.
MAIL_FROM_ADDRESS=noreply@example.com

# ============================================================
# Bangla Fashions Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git (it's in .gitignore).
# ============================================================

# --- Server ---
PORT=8080
NODE_ENV=development

# Frontend origin for CORS. No trailing slash.
# Local:        http://localhost:3000
# Production:   https://banglafashions.com
FRONTEND_URL=http://localhost:3000

# Public base URL of THIS API, used to build absolute payment-gateway callback
# URLs (SSLCommerz success/fail/cancel/IPN). Optional locally — when unset it is
# derived from the proxied request. In the Docker deploy, docker-compose.yml sets
# it from PUBLIC_BACKEND_URL.
# PUBLIC_API_URL=https://banglafashions.com

# --- Database (MongoDB, self-hosted via Docker) ---
# When running via docker compose, the host is the service name (e.g. "mongo").
# Format: mongodb://USER:PASSWORD@HOST:27017/DB_NAME?authSource=admin
MONGODB_URI=mongodb://bangla_fashions_user:REPLACE_WITH_PASSWORD@mongo:27017/bangla-fashions?authSource=admin

# --- Auth ---
# Long random string. Generate with:  openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Comma-separated emails allowed to log in as admin (lowercase, no spaces).
# This gates admin login — an account is only an admin if its email is listed here.
# Add more, comma-separated and no spaces, if a second person needs admin access.
ADMIN_EMAILS=banglafashion2007@gmail.com

# --- License (required when NODE_ENV=production) ---
# Signed token issued by the seller for this domain — the app refuses to
# boot in production without it. Ask whoever you licensed this codebase
# from for the LICENSE_KEY value for your domain. See docs/LICENSING.md.
LICENSE_KEY=

# --- Image storage (local disk) ---
# Product images are written to this directory instead of a CDN, under dated
# subdirectories (<yyyy>/<mm>/<uuid>.webp), and served back at /uploads/*. The
# database stores the RELATIVE url only, never a hostname, so the same rows work
# on localhost and in production.
# Local dev:  ./uploads (relative to the backend working directory)
# Docker:     /app/uploads — set by docker-compose.yml and backed by the
#             `uploads-data` named volume, which is what keeps images alive
#             across rebuilds. Back that volume up along with the database.
UPLOAD_DIR=./uploads

# --- Email (Brevo / Sendinblue transactional API) ---
# Get from https://app.brevo.com/settings/keys/api
# Leave empty to run without email: the mailer logs "Email skipped" and the rest
# of the app, checkout included, works normally.
API_KEY=
MAIL_FROM_NAME=Bangla Fashions
# PLACEHOLDER — must be changed before order emails will send. Brevo only accepts
# a From address on a domain you own and have verified in their dashboard (SPF +
# DKIM records). A gmail.com address will NOT work here and Brevo will reject the
# send. Verify banglafashions.com in Brevo, add the SPF and DKIM records it gives
# you, then set this to noreply@banglafashions.com. The shop's own inbox,
# banglafashion2007@gmail.com, is for customers to write to, not for sending from.
MAIL_FROM_ADDRESS=noreply@example.com

# ============================================================
# Bangla Fashions Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git (it's in .gitignore).
# ============================================================

# --- Server ---
PORT=8080
NODE_ENV=development

# Frontend origin for CORS. No trailing slash.
# Local:        http://localhost:3000
# Production:   the live Bangla Fashions domain, e.g. https://banglafashions.com
#               (https://example.com below is a placeholder, not a real host)
FRONTEND_URL=http://localhost:3000

# --- Database (MongoDB, self-hosted via Docker) ---
# When running via docker compose, the host is the service name (e.g. "mongo").
# Format: mongodb://USER:PASSWORD@HOST:27017/DB_NAME?authSource=admin
MONGODB_URI=mongodb://bangla_fashions_user:REPLACE_WITH_PASSWORD@mongo:27017/bangla-fashions?authSource=admin

# --- Auth ---
# Long random string. Generate with:  openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Comma-separated emails allowed to log in as admin (lowercase, no spaces).
# This gates admin login — an account is only an admin if its email is listed here.
# Add more, comma-separated and no spaces, if a second person needs admin access.
ADMIN_EMAILS=banglafashion2007@gmail.com

# --- License (required when NODE_ENV=production) ---
# Signed token issued by the seller for this domain — the app refuses to
# boot in production without it. Ask whoever you licensed this codebase
# from for the LICENSE_KEY value for your domain.
LICENSE_KEY=

# --- Cloudinary (image storage) ---
# Get from https://console.cloudinary.com/console (Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (Brevo / Sendinblue transactional API) ---
# Get from https://app.brevo.com/settings/keys/api
API_KEY=xkeysib-REPLACE_WITH_BREVO_API_KEY
MAIL_FROM_NAME=Bangla Fashions
# PLACEHOLDER — must be changed before order emails will send. Brevo only accepts
# a From address on a domain you own and have verified in their dashboard (SPF +
# DKIM records). A gmail.com address will NOT work here and Brevo will reject the
# send. Once the Bangla Fashions domain is live, verify it in Brevo and set this
# to something like noreply@<that domain>. The shop's own inbox,
# banglafashion2007@gmail.com, is for customers to write to, not for sending from.
MAIL_FROM_ADDRESS=noreply@example.com

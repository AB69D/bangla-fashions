# Caddy reverse proxy on the Contabo VPS — backend-only (the Bangla Fashions
# storefront is deployed separately; see frontend/.github/workflows/deploy.yml).
# Currently serves HTTP on port 80 by IP (no domain yet).
# When the Bangla Fashions domain points at this Contabo VPS, replace the `:80`
# block with `api.yourdomain.com { reverse_proxy backend:8080 }` and Caddy will
# auto-provision Let's Encrypt HTTPS.

:80 {
    encode zstd gzip
    reverse_proxy backend:8080
}
